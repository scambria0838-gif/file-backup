# ── Authentication ────────────────────────────────────────────────────────────
# Secret header value clients must send as X-Relay-Key
RELAY_SECRET=change-me

# ── OpenRouter (cloud) ────────────────────────────────────────────────────────
OPENROUTER_KEY=sk-or-v1-...
# Default model when a new openrouter model entry points here
# Full list: https://openrouter.ai/models

# ── Ollama (local) ────────────────────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434
# Model names must match what you have pulled: `ollama list`

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080

# ── Session persistence ───────────────────────────────────────────────────────
# JSON file where the autonomous agent's message history and log are saved.
# Delete this file to start completely fresh, or use POST /session/reset.
SESSION_FILE=.session.json
